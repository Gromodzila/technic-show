[Unit]
Description=technic-show failsafe service
Requires=roscore.service
After=network.target

[Service]
User=orangepi
WorkingDirectory=/home/orangepi/technic-show/drone
ExecStart=/bin/bash -c ". /home/orangepi/technic_ws/devel/setup.sh; \
                      ROS_HOSTNAME=`hostname`.local /usr/bin/python3 /home/orangepi/technic-show/drone/failsafe.py"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target